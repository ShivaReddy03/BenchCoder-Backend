SECRET_KEY=replace-with-a-long-random-value
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_PASSWORD=benchcoder-local

# Optional: real AI hints; leave empty to disable without affecting judging.
OPENAI_API_KEY=
AI_HINT_MODEL=gpt-4.1-mini
AI_SOLUTION_MODEL=gpt-4.1-mini
AI_SOLUTIONS_DAILY_LIMIT=10
AI_SOLUTIONS_GLOBAL_DAILY_LIMIT=100
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_HINTS_DAILY_LIMIT=20
AI_HINTS_GLOBAL_DAILY_LIMIT=200

# Optional Pinecone document index with integrated embeddings.
# Set mode=pinecone only after configuring a matching index and credentials.
AI_RETRIEVAL_BACKEND=local
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=benchcoder-knowledge-v1
PINECONE_EMBEDDING_FIELD=chunk_text
PINECONE_EMBEDDING_MODEL=text-embedding-3-small
